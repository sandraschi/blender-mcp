; Kill UI + backend before install/uninstall (backend locks resources/*.exe).
!macro Kill{REPO_PASCAL}FleetProcesses
  DetailPrint "Stopping {REPO} processes..."
  ExecWait 'taskkill /F /IM {REPO}-backend.exe /T' $0
  ExecWait 'taskkill /F /IM {REPO}-native.exe /T' $0
  !if "${INSTALLMODE}" == "currentUser"
    nsis_tauri_utils::KillProcessCurrentUser "{REPO}-backend.exe"
    Pop $0
    nsis_tauri_utils::KillProcessCurrentUser "{REPO}-native.exe"
    Pop $0
  !else
    nsis_tauri_utils::KillProcess "{REPO}-backend.exe"
    Pop $0
    nsis_tauri_utils::KillProcess "{REPO}-native.exe"
    Pop $0
  !endif
  Sleep 2000
!macroend

!macro NSIS_HOOK_PREINSTALL
  !insertmacro Kill{REPO_PASCAL}FleetProcesses
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  !insertmacro Kill{REPO_PASCAL}FleetProcesses
!macroend

!macro NSIS_HOOK_POSTINSTALL
  IfFileExists "$INSTDIR\resources\install-mcp-clients.ps1" 0 mcp_hook_done
    DetailPrint "Optional: register {REPO} in Cursor / Claude Desktop"
    ExecWait 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\resources\install-mcp-clients.ps1" -Interactive'
  mcp_hook_done:
!macroend