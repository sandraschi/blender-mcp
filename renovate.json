{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "stabilityDays": 3,
  "prConcurrentLimit": 3,
  "schedule": ["before 5am on monday"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
